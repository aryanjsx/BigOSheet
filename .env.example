# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway...).
# Use the *pooled* connection string on serverless hosts such as Vercel.
DATABASE_URL=postgres://user:password@host/dbname

# The one account that can write, publish and delete posts, and delete users.
ADMIN_EMAIL=kumararyan1929@gmail.com
# Password for that account. The account is created/updated from this at startup.
ADMIN_PASSWORD=change-me-to-a-long-random-password

SITE_URL=http://localhost:3000
